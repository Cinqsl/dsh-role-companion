{
  "name": "dsh-role-companion",
  "version": "0.1.3",
  "type": "module",
  "description": "DSH 角色伙伴",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Cinqsl/dsh-role-companion.git",
    "directory": "packages/companion"
  },
  "homepage": "https://github.com/Cinqsl/dsh-role-companion#readme",
  "bugs": {
    "url": "https://github.com/Cinqsl/dsh-role-companion/issues"
  },
  "main": "lib/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./runtime": {
      "types": "./src/runtime/index.ts",
      "default": "./lib/runtime.js"
    },
    "./client": {
      "types": "./src/client/index.tsx",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json",
    "./types": "./src/types.ts",
    "./home": {
      "types": "./src/home/index.ts",
      "default": "./lib/home.js"
    },
    "./files": {
      "types": "./src/adapters/local-files.ts",
      "default": "./lib/files.js"
    }
  },
  "files": [
    "lib/index.js",
    "lib/runtime.js",
    "lib/client.js",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "cordis.patch.yml",
    "README.md",
    "lib/home.js",
    "lib/files.js"
  ],
  "engines": {
    "node": ">=24",
    "dsh": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.2": "compatible",
        "0.2.1-rc.3": "compatible"
      }
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3",
    "ws": "8.22.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-spill-local": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.2 || 0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2 || 0.2.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "@deepseek-ai/dsh-commands": "0.2.1-rc.3",
    "@deepseek-ai/dsh-host-plugin-inventory": "0.2.1-rc.3",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.3",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.3",
    "@deepseek-ai/dsh-config-editor": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.3",
    "@deepseek-ai/dsh-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.3",
    "@deepseek-ai/dsh-llm-deepseek-api-key": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction": "0.2.1-rc.3",
    "@deepseek-ai/dsh-spill": "0.2.1-rc.3",
    "@deepseek-ai/dsh-spill-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.3",
    "@deepseek-ai/dsh-token-meter": "0.2.1-rc.3",
    "@deepseek-ai/dsh-tool-fs-search": "0.2.1-rc.3",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.3",
    "@deepseek-ai/dsh-compaction-basic": "0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.1-rc.3",
    "@deepseek-ai/dsh-scope": "0.2.1-rc.3",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.3",
    "@deepseek-ai/dsh-credentials-local": "0.2.1-rc.3",
    "@deepseek-ai/dsh-attachment-local": "0.2.1-rc.3",
    "@deepseek-ai/cordis-plugin-include": "1.0.10",
    "@deepseek-ai/dsh-storage": "0.2.1-rc.3",
    "@deepseek-ai/dsh-storage-json": "0.2.1-rc.3",
    "@deepseek-ai/dsh-atomic-write": "0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.3"
  }
}
